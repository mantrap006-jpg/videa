MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/videa
JWT_SECRET=replace-with-a-long-random-secret

# Used only to create/update the first administrator in MongoDB.
DEFAULT_ADMIN_NAME=Videa Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Creator subscription prices (RWF); defaults are monthly 5,000, quarterly 13,500, annual 50,000.
CREATOR_SUBSCRIPTION_PRICE_RWF=5000
CREATOR_QUARTERLY_PRICE_RWF=13500
CREATOR_ANNUAL_PRICE_RWF=50000
CREATOR_USSD_NUMBER=YOUR_MOBILE_MONEY_NUMBER
CREATOR_PAYMENT_NETWORK=MTN / Airtel Money
